# Recommended cron jobs for Proxmox homelab
# Add to /etc/crontab or use crontab -e

# Daily backup at 2 AM
0 2 * * * root /opt/scripts/backup-all.sh >> /var/log/backup.log 2>&1

# Health check every 5 minutes
*/5 * * * * root /opt/scripts/health-check.sh >> /var/log/health.log 2>&1

# Weekly update check (Sunday 3 AM)
0 3 * * 0 root apt update && apt list --upgradable >> /var/log/updates.log 2>&1

# Monthly reboot (1st of month, 4 AM) - optional
# 0 4 1 * * root /sbin/reboot

# Clean old logs weekly
0 1 * * 0 root find /var/log -name "*.log" -mtime +30 -delete
